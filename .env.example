# Required for live Jev unless you pass --stub-judge
TYPESAFE_API_KEY=

# live | fixture | auto (try live, sticky-fallback to fixture on transport failure)
POLYMARKET_SOURCE=auto

# Which assets and timeframes to scan (comma-separated).
# Assets:   btc, eth, sol, xrp, doge, bnb
# Timeframes: 5m, 15m, (1h)
ASSETS=btc,eth,sol,xrp,doge,bnb
TIMEFRAMES=5m,15m

# Optional Gamma event slug override (single-market debug only)
# BTC_UPDOWN_SLUG=

# Loop interval for npm run watch (~5s reassessment)
TICK_MS=5000

# ENTER only when conf strictly greater than this; then hold to window end
ACT_THRESHOLD=0.90

# Max USD notional per ENTER (shares = floor(stake / ask price))
BET_USD=5

# Fractional-Kelly sizing: stake = min(BET_USD, kelly_fraction * f* * BANKROLL_USD)
BANKROLL_USD=100
KELLY_FRACTION=0.25

# Refuse ENTER if ask is above this (avoid expensive favorites)
MAX_ASK=0.70

# Refuse ENTER if top-of-book spread is wider than this
MAX_SPREAD=0.02

# Require P(win) >= ask + MIN_EDGE (real EV, not conf alone)
MIN_EDGE=0.10

# No new ENTER in the last N seconds of the window
MIN_SECONDS_TO_ENTER=90

# Analyze stage (runs before JEV): skip bad regimes
# Direction must hold this long; windows with 1m vol below MIN_VOL_PCT are skipped
REQUIRE_TREND_HELD_SEC=60
MIN_VOL_PCT=0.02
# 1 = enforce the analyze-stage skips / 0 = advisory only
ENFORCE_STRATEGY=1
# 1 = refuse ENTER when JEV fights the momentum bias
REQUIRE_BIAS_AGREEMENT=1

# Lock profit: sell an open position once its bid reaches this (0 disables)
TAKE_PROFIT_PRICE=0.90

# One enter per window (ride to resolution)
MAX_ENTERS_PER_WINDOW=1

# LIVE ORDERS ARE REAL TRADES. Dry-run remains the default.
# To arm live orders, set the exact confirmation value below. MCP calls still default to paper;
# each live call requires direct human approval in a supported MCP client form.
# Use only a dedicated low-balance signer wallet/key; never paste secrets into chat.
# LIVE_TRADING=1
# LIVE_TRADING_CONFIRM=I_ACCEPT_REAL_MONEY_RISK
# WALLET_PVK=0x...                 # signer private key; keep only in ignored .env
# POLYMARKET_SOURCE=live            # required; auto may fall back to fixture markets
# SIGNATURE_TYPE=3                  # 0=EOA, 1=Proxy, 2=Safe, 3=Deposit Wallet
# POLYMARKET_FUNDER=0x...           # account wallet address for signature types 1/2/3
# LIVE_MAX_ORDER_USD=5              # refuse any order above this notional
# BET_USD=5                         # strategy stake cap; keep <= LIVE_MAX_ORDER_USD
# The account must already be funded and have trading approvals set up on Polymarket.
# This bot does not deposit funds or set approvals.

# Append-only PnL ledger
# PNL_PATH=data/pnl.jsonl

# Web dashboard (npm run web). Binds to localhost by default.
# WEB_PORT=3000
# WEB_HOST=127.0.0.1
